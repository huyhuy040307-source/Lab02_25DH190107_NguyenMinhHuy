@{
    Layout = null;
}

<!DOCTYPE html>

<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>Dàn trang webside</title>
    <style type="text/css">
        body{
            background-color:antiquewhite;
            font-family;"Book Antiqua",calibri,"Courier New";
        }
        #contaner{
            border:3px solid black; /*khi dựng layout thật thì ko cần để border*/
            background-color:cornsilk;
            width:90%;
            margin:auto;

        }
        #banner{
            background-color:lightgray;
            height:100px;
        }
        #navigator, #footer{
            border-top:1px solid black;
            background-color:dimgray;
            border-bottom:1px solid black;
            height:50px;
            padding-top:5px;
            padding-bottom:5px;
        }
        #sidebar {
            /*display:block;*/
            background-color: gray;
            width: 150px;
            float: left;
            min-height:400px;
            border-right:1px solid black;
        }
        #foodter{
            text-align:center;
        }
        #content {
            /*float:left;*/
            margin-left:150px;
            min-height:400px;
            background-color:floralwhite;
        }
    </style>
</head>
<body>
    <div id="contaner">
        <div id="banner">BANNER</div>
        <div id="navigator">NAVIGATOR</div>
        <div id="sidebar">SIDEBAR</div>
        <div id="content">CONTENT</div>
        <div id="footer">FOOTER</div>
    </div>
</body>
</html>
