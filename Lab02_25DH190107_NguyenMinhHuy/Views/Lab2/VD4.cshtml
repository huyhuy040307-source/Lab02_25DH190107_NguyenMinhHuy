@{
    Layout = null;
}

<!DOCTYPE html>

<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>Tạo thanh Navigator</title>
    <style type="text/css">
        a,a:visited{
            display:block;
            position:relative;
            padding:5px;
            margin:10px auto;
            border:2px solid black;
            background-color:lightgray;
            border-color:aqua aquamarine antiquewhite black;
            width:100px;
            text-align:center;
            text-decoration:none;
            color:white;
        }
        a:hover{
            color:red;
            top:5px;
            left:5px;
            background-color:yellow;
        }


    </style>
</head>
<body>
    <div>
        <a href="#">Home</a>
        <a href="#">About</a>
        <a href="#">History</a>
        <a href="#">Team</a>
        <a href="#">Offices</a>
    </div>
</body>
</html>
