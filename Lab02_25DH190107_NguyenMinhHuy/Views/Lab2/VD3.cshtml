@{
    Layout = null;
}

<!DOCTYPE html>

<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>Định dạng danh sách</title>
</head>
<body>
    <div>
        <p>Đây là danh sách dạng inside</p>
        <ul style="list-style:square; list-style-position:inside">
            <li>Item 1</li>
            <li>Item 2</li>
            <li>Item 3</li>
        </ul>
        <p>Đây là danh sách dạng outside</p>
        <ul style="list-style:square; list-style-position:outside">
            <li>Item 1</li>
            <li>Item 2</li>
            <li>Item 3</li>
        </ul>
        <p>Đây là danh sách position ko có bullet</p>
        <ul style="list-style-type:none">
            <li>Item 1</li>
            <li>Item 2</li>
            <li>Item 3</li>
        </ul>

    </div>
</body>
</html>
